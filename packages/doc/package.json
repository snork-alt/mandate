{
  "name": "@mandate/doc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Structured markdown documents: YAML frontmatter + id-marked sections",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./split": {
      "types": "./dist/split/index.d.ts",
      "default": "./dist/split/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "diff": "^9.0.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4"
  },
  "license": "FSL-1.1-ALv2"
}
