exports[`zed MCP > merges into the existing user config, idempotently; removal restores it 1`] = `
{
  "headers": {
    "Authorization": "Bearer mnd_web-app_SECRETKEY123",
  },
  "url": "http://localhost:4000/p/web-app/mcp",
}
`;

exports[`zed install / connect / uninstall > writes exactly these files, idempotently, and uninstall removes them 1`] = `
{
  "connected": [
    "AGENTS.md",
  ],
